{
  "homepage": "https://github.com/sysui/renovate-config#readme",
  "bugs": {
    "url": "https://github.com/sysui/renovate-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sysui/renovate-config.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "npx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.14.0"
  }
}
